# Copy this file to `.env` and fill in your own local values.
# `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env

# MySQL / MariaDB connection used by the Jupyter notebook and docker-compose
DB_USER=admindjango
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=LittleLemonDB

# Used by docker-compose to bootstrap the MySQL container
MYSQL_ROOT_PASSWORD=change_me_root
